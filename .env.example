# LM Studio (API compatível com OpenAI)
# Local: http://localhost:1234/v1
# Docker: http://host.docker.internal:1234/v1 (sobrescrito automaticamente pelo compose)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_LLM_MODEL=phi-3-mini
LM_STUDIO_EMBEDDING_MODEL=nomic-embed-text

# Retry/backoff e timeout nas chamadas ao LM Studio
# LLM_MAX_RETRIES=2
# LLM_REQUEST_TIMEOUT=60.0
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_REQUEST_TIMEOUT=30.0

# ChromaDB
# Local: ./chroma_db  |  Docker (dentro do container): /app/chroma_db
CHROMA_DIR=./chroma_db

# Dados
DATA_DIR=./data

# API
API_HOST=0.0.0.0
API_PORT=8000
# Chave de admin do POST /ingest: obrigatória, forte (>= 16 chars) e não-placeholder
ADMIN_API_KEY=troque-por-chave-segura
MAX_UPLOAD_MB=25

# CORS (origens/métodos/headers separados por vírgula; "*" permite todos)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# UI
API_BASE_URL=http://localhost:8000

# Logs
LOG_LEVEL=INFO
LOG_DIR=./logs

# Health check (/health) — timeout em segundos por probe (ChromaDB e LM Studio)
HEALTHCHECK_TIMEOUT=3.0

# Reranking cross-encoder (RAG-01) — reordena candidatos do retrieve por relevância
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVAL_RERANK_TOP_N=20
RETRIEVAL_RERANK_BATCH_SIZE=16

# Busca híbrida (RAG-02) — combina denso (embeddings) + esparso (BM25) via RRF
RETRIEVAL_HYBRID_ENABLED=false
RETRIEVAL_HYBRID_RRF_K=60
RETRIEVAL_HYBRID_SPARSE_TOP_K=20
# Stopwords da tokenização esparsa (separadas; unidades de dosagem mg/ml/g/kg são preservadas)
RETRIEVAL_SPARSE_STOPWORDS=qual,quais,como,para,com,sem,dos,das,pelo,pela,uma,um,a,o,e,de,da,do,em,por,que,quando,onde,se,na,no,ao,aos,ser,sao,esta,sendo,fazer,faz,pode,podem,deve,devem,uso,usar,tomar,tomada,dia,dias,dose,doses,maxima,maximo,adulto,adultos,crianca,criancas,tem,ter,via,oral,recomendada,recomendado,indicado,indicada

# Reescrita de consultas curtas (RAG-03) — expande consultas curtas via LLM local
RETRIEVAL_QUERY_REWRITE_ENABLED=false   # off por padrão (identidade)
RETRIEVAL_QUERY_REWRITE_MIN_LENGTH=3    # min de tokens de conteúdo abaixo do qual a query é curta (estrito <; gt=0)
RETRIEVAL_QUERY_REWRITE_MODEL=          # vazio → usa LM_STUDIO_LLM_MODEL
RETRIEVAL_QUERY_REWRITE_TEMPERATURE=0.0 # baixa para determinismo (ge=0.0, le=2.0)
RETRIEVAL_QUERY_REWRITE_MAX_TOKENS=128  # limite de geração do LLM de reescrita (gt=0)
RETRIEVAL_QUERY_REWRITE_MAX_OUTPUT=200  # limite de caracteres da query reescrita aceita (gt=0)

# Decomposição de perguntas multi-parte (RAG-03) — divide perguntas compostas
# em sub-perguntas, cada uma com retrieval/citações próprios, e re-combina o resultado.
RETRIEVAL_DECOMPOSE_ENABLED=false                 # off por padrão (identidade)
RETRIEVAL_DECOMPOSE_MAX_SUB_QUESTIONS=5           # cap de sub-perguntas processadas (gt=0)
RETRIEVAL_DECOMPOSE_MODEL=                        # vazio → usa LM_STUDIO_LLM_MODEL
RETRIEVAL_DECOMPOSE_TEMPERATURE=0.0               # baixa para determinismo (ge=0.0, le=2.0)
RETRIEVAL_DECOMPOSE_MAX_TOKENS=256                # limite de geração do LLM de split (gt=0)
RETRIEVAL_DECOMPOSE_MIN_TOKENS=4                 # gate da heurística _is_compound — mínimo de TOKENS TOTAIS (gt=0)

# Avaliação RAG (offline)
EVAL_GOLDEN_SET_PATH=evals/dataset/golden_set.json
EVAL_LLM_MODEL=                # vazio → usa LM_STUDIO_LLM_MODEL
EVAL_EMBEDDING_MODEL=          # vazio → usa LM_STUDIO_EMBEDDING_MODEL
EVAL_BATCH_SIZE=16

# Generation (RAG-05) — streaming de respostas via SSE
# Off por padrão — byte-identical: quando desabilitado, /query permanece igual e
# /query/stream responde 404.
GENERATION_STREAMING_ENABLED=false

# Profiles
MEDICO_TEMPERATURE=0.1
MEDICO_MAX_TOKENS=1024
ENFERMEIRO_TEMPERATURE=0.15
ENFERMEIRO_MAX_TOKENS=1024
ASSISTENTE_TEMPERATURE=0.2
ASSISTENTE_MAX_TOKENS=512
PACIENTE_TEMPERATURE=0.3
PACIENTE_MAX_TOKENS=512
